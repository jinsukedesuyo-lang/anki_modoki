# =====================================================================
#  Ankiもどき: AIイメージ生成（Google AI Studio / Gemini API）の設定
#  このファイルをコピーして supabase/functions/.env を作り、値を入れてください。
#  .env は .gitignore 済みなので GitHub には上がりません。
#  反映: npx supabase secrets set --env-file supabase/functions/.env
# =====================================================================

# --- APIキー（必須）---------------------------------------------------
# Google AI Studio（https://aistudio.google.com/apikey）で発行したキー。
# 画像生成は無料枠では使えないため、課金（Billing）を有効にしたプロジェクトのキーを使ってください。
GEMINI_API_KEY=

# --- 使うモデル -------------------------------------------------------
# 最新の一覧: https://ai.google.dev/gemini-api/docs/models
# 文脈の分析（テキスト）。精度を上げたいときは gemini-3.8-flash など
ANKI_TEXT_MODEL=gemini-3.5-flash-lite
# 分析の思考量: minimal / low / medium / high（上げるほど精度↑・料金↑）
ANKI_TEXT_THINKING=low
# 画像生成。画質を上げたいときは gemini-3.1-flash-image など
ANKI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# --- 料金（USD / 100万トークン）--------------------------------------
# 利用料の計測に使う単価。モデルを変えたり料金が改定されたら更新してください。
# 最新の料金: https://ai.google.dev/gemini-api/docs/pricing
ANKI_PRICE_TEXT_INPUT=0.30
ANKI_PRICE_TEXT_OUTPUT=2.50
ANKI_PRICE_IMAGE_INPUT=0.25
ANKI_PRICE_IMAGE_OUTPUT_TEXT=1.50
ANKI_PRICE_IMAGE_OUTPUT_IMAGE=30

# --- 使いすぎ防止 -----------------------------------------------------
# 1か月の上限（USD）。超えると生成を止めます。0 で無制限
ANKI_MONTHLY_BUDGET_USD=5
