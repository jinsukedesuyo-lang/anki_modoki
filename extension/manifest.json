{
  "manifest_version": 3,
  "name": "Anki Modoki Capture",
  "version": "1.0.0",
  "description": "Make Anki Modoki cards from YouTube / Netflix (Language Reactor) subtitles, the selected word and a screenshot.",
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "Anki Modoki: make a card (Alt+A)", "default_icon": { "16": "icons/icon-16.png", "48": "icons/icon-48.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting", "contextMenus", "storage", "tabs"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.netflix.com/*",
    "https://*.github.io/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://www.netflix.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "capture": {
      "suggested_key": { "default": "Alt+A" },
      "description": "Make a card from the current subtitle, the selected word and a screenshot"
    }
  },
  "options_page": "options.html"
}
